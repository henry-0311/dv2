{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CHART 7 - Proportional symbol map with length-proportional bars (map idiom 2; bar symbols appear in the FIT3179 Proportional Symbol Maps notes). Each state has two bars: green = output growth (ABARES table 9) and mustard = input growth (table 8), All industries, % a year, 1977-78 to 2024-25. A bar going up = growth, down = decline. How the bars are drawn: each bar is a 'point' mark whose shape is an SVG path built from the data (calculate step 'bar_path'). With size = 4 the path coordinates are in screen pixels, so 1% a year = 20 px exactly and bars stay vertical on the projected map. The thin outline frame around each pair spans -2% to +2% (framed bars are easier to compare). Bar positions (lon/lat in state_output_input.csv) were chosen by the author to sit inside each state. Projection: Albers conic equal-area, standard parallels 18 S and 36 S. Colour key: the words 'output' (green) and 'inputs' (mustard) in the subtitle, instead of a legend box.",
  "width": "container",
  "height": 430,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E7E2D4",
        "stroke": "#FBF8F1",
        "strokeWidth": 1
      }
    },
    {
      "description": "Frame: a thin outline from -2% to +2% (40 px up and down) around each pair of bars, transparent inside so the map stays visible, with a grey zero line across it.",
      "data": {
        "url": "data/state_output_input.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "output_growth": "number",
            "input_growth": "number",
            "productivity_growth": "number"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "size": 4,
            "filled": false,
            "stroke": "#8F887A",
            "strokeWidth": 1,
            "opacity": 1,
            "shape": "M-19,-40 L19,-40 L19,40 L-19,40 Z"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "size": 4,
            "filled": false,
            "color": "#6B6B60",
            "strokeWidth": 1,
            "opacity": 1,
            "shape": "M-19,0 L19,0"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        }
      ]
    },
    {
      "description": "The bars. fold makes two rows per state (output, inputs). bar_path is a rectangle 10 px wide whose top is value x 20 px above the point (negative values go below). Output sits on the left of the point, inputs on the right.",
      "data": {
        "url": "data/state_output_input.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "output_growth": "number",
            "input_growth": "number",
            "productivity_growth": "number"
          }
        }
      },
      "transform": [
        {
          "fold": [
            "output_growth",
            "input_growth"
          ],
          "as": [
            "measure",
            "value"
          ]
        },
        {
          "calculate": "datum.measure === 'output_growth' ? 'Output' : 'Inputs'",
          "as": "measure_label"
        },
        {
          "calculate": "datum.measure === 'output_growth' ? -14 : 2",
          "as": "left"
        },
        {
          "calculate": "-datum.value * 20",
          "as": "top"
        },
        {
          "calculate": "'M' + datum.left + ',0 L' + (datum.left + 12) + ',0 L' + (datum.left + 12) + ',' + datum.top + ' L' + datum.left + ',' + datum.top + ' Z'",
          "as": "bar_path"
        }
      ],
      "mark": {
        "type": "point",
        "size": 4,
        "filled": true,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "shape": {
          "field": "bar_path",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "color": {
          "field": "measure_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Output",
              "Inputs"
            ],
            "range": [
              "#5E9B57",
              "#C99A2E"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "output_growth",
            "title": "Output growth (% a year)",
            "format": "+.1f"
          },
          {
            "field": "input_growth",
            "title": "Input growth (% a year)",
            "format": "+.1f"
          },
          {
            "field": "productivity_growth",
            "title": "Productivity growth (% a year)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "description": "State label to the left of each symbol, level with its zero line, so each label clearly belongs to one symbol.",
      "data": {
        "url": "data/state_output_input.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "output_growth": "number",
            "input_growth": "number",
            "productivity_growth": "number"
          }
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1E1E1E",
        "baseline": "middle",
        "align": "right",
        "dx": -23
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr"
        }
      }
    },
    {
      "description": "Scale key in the Indian Ocean: a grey bar showing what +1% a year looks like (20 px).",
      "data": {
        "values": [
          {
            "lon": 113.5,
            "lat": -39.5
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "size": 4,
            "filled": true,
            "color": "#8F8F85",
            "opacity": 1,
            "shape": "M-6,0 L6,0 L6,-20 L-6,-20 Z"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "dy": -10,
            "fontSize": 11,
            "color": "#4A4A42"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "value": "= +1% a year"
            }
          }
        }
      ]
    }
  ]
}